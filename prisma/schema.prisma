// Prisma schema for Kanto't Pakpakan restaurant management system.
// Database: TiDB Serverless (MySQL wire-compatible).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider     = "mysql"
  // TiDB Serverless: use Prisma-level relation handling instead of DB-enforced
  // foreign keys, per Prisma's TiDB deployment guidance. The connection URL
  // itself is configured in prisma.config.ts and via the adapter in lib/db.ts.
  relationMode = "prisma"
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  // Seeded roles (System Admin, Manager, Staff) are protected from deletion.
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id        String   @id @default(cuid())
  // Stable identifier used in code, e.g. "expenses.view", "users.manage".
  key       String   @unique
  label     String
  // Groups permissions in the roles UI, e.g. "Expenses", "Users", "Roles".
  module    String
  createdAt DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model User {
  id                 String    @id @default(cuid())
  username           String    @unique
  passwordHash       String
  fullName           String
  birthday           DateTime? @db.Date
  dateHired          DateTime? @db.Date
  mustChangePassword Boolean   @default(false)
  isActive           Boolean   @default(true)
  roleId             String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  role                 Role                 @relation(fields: [roleId], references: [id])
  expenses             Expense[]
  cashSummariesCreated DailyCashSummary[]   @relation("CashSummaryCreatedBy")
  cashSummariesUpdated DailyCashSummary[]   @relation("CashSummaryUpdatedBy")
  schedules            EmployeeSchedule[]
  bankEntries          BankEntry[]
  gcashEntries         GcashEntry[]
  loyaltyTransactions  LoyaltyTransaction[]
  loyverseOrdersSent   CustomerOrder[]      @relation("LoyverseOrderSentBy")

  @@index([roleId])
  @@map("users")
}

model EmployeeSchedule {
  id           String   @id @default(cuid())
  scheduleDate DateTime @db.Date
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([scheduleDate, userId])
  @@index([userId])
  @@map("employee_schedules")
}

model Expense {
  id          String   @id @default(cuid())
  name        String
  amount      Decimal  @db.Decimal(12, 2)
  remarks     String?  @db.Text
  receiptUrl  String?  @db.Text
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([createdById])
  @@map("expenses")
}

model BankEntry {
  id           String    @id @default(cuid())
  entryType    String
  businessDate DateTime? @db.Date
  name         String
  amount       Decimal   @db.Decimal(12, 2)
  remarks      String?   @db.Text
  receiptUrl   String?   @db.Text
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([entryType])
  @@index([businessDate])
  @@index([createdById])
  @@map("bank_entries")
}

model DailyCashSummary {
  id                     String   @id @default(cuid())
  businessDate           DateTime @unique @db.Date
  startingAmount         Decimal  @default(0) @db.Decimal(12, 2)
  adjustments            Decimal  @default(0) @db.Decimal(12, 2)
  cashOnHand             Decimal  @default(0) @db.Decimal(12, 2)
  openingCashForTomorrow Decimal  @default(0) @db.Decimal(12, 2)
  notes                  String?  @db.Text
  createdById            String
  updatedById            String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  createdBy       User                  @relation("CashSummaryCreatedBy", fields: [createdById], references: [id])
  updatedBy       User                  @relation("CashSummaryUpdatedBy", fields: [updatedById], references: [id])
  adjustmentItems DailyCashAdjustment[]

  @@index([createdById])
  @@index([updatedById])
  @@map("daily_cash_summaries")
}

model DailyCashAdjustment {
  id        String   @id @default(cuid())
  summaryId String
  name      String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  summary DailyCashSummary @relation(fields: [summaryId], references: [id], onDelete: Cascade)

  @@index([summaryId])
  @@map("daily_cash_adjustments")
}

model DailyPosReport {
  id               String   @id @default(cuid())
  businessDate     DateTime @unique @db.Date
  grossSales       Decimal  @default(0) @db.Decimal(12, 2)
  deliveryFeeTotal Decimal  @default(0) @db.Decimal(12, 2)
  netSales         Decimal  @default(0) @db.Decimal(12, 2)
  cashTotal        Decimal  @default(0) @db.Decimal(12, 2)
  cardTotal        Decimal  @default(0) @db.Decimal(12, 2)
  otherTotal       Decimal  @default(0) @db.Decimal(12, 2)
  receiptCount     Int      @default(0)
  paymentCount     Int      @default(0)
  paymentBreakdown Json
  fetchedAt        DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("daily_pos_reports")
}

// Cached per-day GCash sales total from Loyverse (same pattern as
// DailyPosReport), kept separate so syncing it never touches the cash
// summary/bank flows that already read DailyPosReport.
model DailyGcashSale {
  id           String   @id @default(cuid())
  businessDate DateTime @unique @db.Date
  gcashTotal   Decimal  @default(0) @db.Decimal(12, 2)
  fetchedAt    DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("daily_gcash_sales")
}

// A GCash ledger entry: either money remitted from the GCash wallet to the
// admin, or a supply expense paid directly out of the GCash wallet. Both
// entry types subtract from the synced GCash sales total, so `amount` is
// always stored positive.
model GcashEntry {
  id           String    @id @default(cuid())
  entryType    String
  businessDate DateTime? @db.Date
  name         String
  amount       Decimal   @db.Decimal(12, 2)
  remarks      String?   @db.Text
  receiptUrl   String    @db.Text
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([entryType])
  @@index([businessDate])
  @@index([createdById])
  @@map("gcash_entries")
}

model CustomerOrder {
  id                    String    @id @default(cuid())
  orderNumber           String    @unique
  customerId            String?
  customerName          String
  phoneNumber           String
  orderType             String
  paymentMethod         String    @default("cash")
  customerNote          String?   @db.Text
  scheduledFor          DateTime
  deliveryAddress       String?   @db.Text
  deliveryLatitude      Decimal?  @db.Decimal(10, 7)
  deliveryLongitude     Decimal?  @db.Decimal(10, 7)
  totalAmount           Decimal   @db.Decimal(12, 2)
  status                String    @default("pending")
  loyverseReceiptNumber String?   @unique
  loyverseSyncedAt      DateTime?
  loyverseSyncError     String?   @db.Text
  loyverseSentById      String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  customer            Customer?            @relation(fields: [customerId], references: [id])
  loyverseSentBy      User?                @relation("LoyverseOrderSentBy", fields: [loyverseSentById], references: [id])
  items               CustomerOrderItem[]
  loyaltyTransactions LoyaltyTransaction[]

  @@index([customerId])
  @@index([loyverseSentById])
  @@index([status])
  @@map("customer_orders")
}

model Customer {
  id                         String    @id @default(cuid())
  phoneNumber                String?   @unique
  displayName                String
  email                      String    @unique
  address                    String?   @db.Text
  birthday                   DateTime? @db.Date
  // Null for accounts created via Google/Facebook that never set a password.
  passwordHash               String?   @db.Text
  emailVerified              Boolean   @default(false)
  verificationTokenHash      String?   @unique
  verificationTokenExpiresAt DateTime?
  googleId                   String?   @unique
  facebookId                 String?   @unique
  loyaltyCode                String    @unique
  loyaltyPoints              Int       @default(0)
  lifetimePoints             Int       @default(0)
  redeemedPoints             Int       @default(0)
  pendingStampAmount         Decimal   @default(0) @db.Decimal(12, 2)
  lastOrderAt                DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  orders              CustomerOrder[]
  loyaltyTransactions LoyaltyTransaction[]
  loyaltyRewardClaims LoyaltyRewardClaim[]

  @@index([displayName])
  @@map("customers")
}

model LoyaltyReward {
  id             String   @id @default(cuid())
  stampsRequired Int      @unique
  rewardName     String
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  claims LoyaltyRewardClaim[]

  @@map("loyalty_rewards")
}

// Tracks which reward tiers a customer has already claimed in their current
// stamp cycle, since redeeming a mid-tier reward no longer resets their
// stamp balance — only claiming the final (highest) tier does, which also
// clears these rows so every tier can be claimed again next cycle.
model LoyaltyRewardClaim {
  id         String   @id @default(cuid())
  customerId String
  rewardId   String
  claimedAt  DateTime @default(now())

  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reward   LoyaltyReward @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@unique([customerId, rewardId])
  @@index([rewardId])
  @@map("loyalty_reward_claims")
}

model LoyaltySettings {
  id            String   @id @default("default")
  spendPerStamp Decimal  @default(200) @db.Decimal(12, 2)
  updatedAt     DateTime @updatedAt

  @@map("loyalty_settings")
}

model LoyaltyTransaction {
  id           String   @id @default(cuid())
  customerId   String
  orderId      String?
  type         String
  points       Int
  balanceAfter Int
  rewardName   String?
  remarks      String?  @db.Text
  createdById  String?
  createdAt    DateTime @default(now())

  customer  Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order     CustomerOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy User?          @relation(fields: [createdById], references: [id])

  @@index([customerId])
  @@index([orderId])
  @@index([createdById])
  @@index([type])
  @@map("loyalty_transactions")
}

model MenuProduct {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String?  @db.Text
  price       Decimal  @db.Decimal(12, 2)
  imageUrl    String?  @db.Text
  isAvailable Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isAvailable])
  @@map("menu_products")
}

model CustomerOrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  productName String
  unitPrice   Decimal  @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  order CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("customer_order_items")
}
