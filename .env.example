# Copy this file to .env and fill in real values. Never commit .env.

# Local MySQL/MariaDB connection string.
# Format: mysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="mysql://root:asd123@localhost:3306/db_kp"

# Random secret used to sign auth session tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# Vercel Blob token for receipt and menu image uploads.
# Vercel project > Storage > Create Database > Blob > copy the "BLOB_READ_WRITE_TOKEN".
# Required in production. Leave empty for local dev — uploads will fall back to public/uploads/ instead.
BLOB_READ_WRITE_TOKEN=""
LOYVERSE_ACCESS_TOKEN=""
LOYVERSE_STORE_ID=""
LOYVERSE_EMPLOYEE_ID=""
LOYVERSE_CASH_PAYMENT_TYPE_ID=""
LOYVERSE_GCASH_PAYMENT_TYPE_ID=""
LOYVERSE_BANK_TRANSFER_PAYMENT_TYPE_ID=""

# Signs customer (eLoyalty) session cookies. Must be different from AUTH_SECRET
# so a customer session can never be mistaken for a staff session. Generate
# the same way as AUTH_SECRET.
CUSTOMER_AUTH_SECRET=""

# Used to build the link inside verification emails, e.g. https://kantotpakpakan.com.
# Falls back to http://localhost:3001 in development.
NEXT_PUBLIC_APP_URL=""

# Resend (resend.com) API key for sending eLoyalty verification emails.
# Leave unset in development to log verification links to the console
# instead of sending real email. RESEND_FROM must use resend.dev (their
# shared test domain) until kantotpakpakan.com is verified in the Resend
# dashboard, after which it can switch to noreply@kantotpakpakan.com.
RESEND_API_KEY=""
RESEND_FROM="Kanto't Pakpakan <onboarding@resend.dev>"
